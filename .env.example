# Voyage Outdoor — server environment. Copy to .env and fill in.
# .env is gitignored. Nothing in here is ever shipped to the app.

ENV=local

# --- Supabase: Voyage Outdoor's OWN project (never VoyageOS's) ---
SUPABASE_URL=https://tebrcqqndpgcbedapwbn.supabase.co
# Project Settings → API → service_role key. SERVER ONLY. This key bypasses RLS.
SUPABASE_SERVICE_KEY=

# Local stand-in for a signed-in user, honoured ONLY when ENV=local and the
# request carries no Bearer token. Set it to a real auth.users id to work
# against the API without the app running.
DEV_USER_ID=

# --- AI gateway (nothing calls a model until Phase 4) ---
LLM_API_KEY=
AI_DAILY_COST_CAP_USD=0.50

# --- the coarse gate ---
# Set on cloud deploys; leave blank locally to turn the gate off. The app sends
# this as x-voyage-key. Generate with: openssl rand -hex 16
APP_SHARED_SECRET=
# Holds a value ONLY during a rotation, while an older build is still in
# circulation. Empty is the normal state — leaving one here after adoption
# quietly doubles the number of keys that open the door.
APP_SHARED_SECRET_PREVIOUS=
